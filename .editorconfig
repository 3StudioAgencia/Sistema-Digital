# EditorConfig — convenções mínimas e consistentes entre editores
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,css,yml,yaml}]
indent_size = 2

[*.md]
# Markdown usa espaços duplos no fim da linha como quebra intencional
trim_trailing_whitespace = false
indent_size = 2

[Makefile]
indent_style = tab
