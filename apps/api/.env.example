# ============================================================================
# Backend (apps/api) — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env com valores reais.
# Provisionamento passo-a-passo: docs/setup-infra.md
# ============================================================================

# Ambiente de execução: dev | test | staging | production
# Em staging/produção DEFINA explicitamente — o default "dev" existe só para a
# DX local; se esquecido no deploy, a observabilidade (readiness/logs) rotularia
# o ambiente como "dev".
APP_ENV=dev

# Nível de log do backend (JSON estruturado em stdout): DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Banco de dados — DUAS URLs distintas (ADR-007)
# ----------------------------------------------------------------------------
# RUNTIME da aplicação → pooler de transação do Supabase (PORTA 6543, PgBouncer).
# Formato Supabase: postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:6543/postgres
# Em dev local (docker compose up -d db), aponte para o Postgres local:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rastreio

# MIGRATIONS (Alembic) → conexão DIRETA/sessão (PORTA 5432) — DDL exige sessão.
# Formato Supabase (conexão direta): postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
#   ATENÇÃO: a conexão direta db.<ref>.supabase.co é IPv6-ONLY em projetos novos;
#   em rede sem IPv6 ela falha com gaierror. Alternativa portável (ADR-007,
#   emenda): POOLER EM MODO SESSION — mesma porta 5432, host do pooler, usuário
#   postgres.<ref> (suporta DDL/prepared statements):
#   postgresql://postgres.<ref>:<senha>@aws-1-<região>.pooler.supabase.com:5432/postgres
#   Detalhes em docs/setup-infra.md §1.
# Em dev local, pode ser a mesma instância do runtime:
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rastreio

# ----------------------------------------------------------------------------
# Supabase Auth — verificação de JWT (Wave 1 / C03). PyJWT SÓ verifica, nunca
# emite (CLAUDE.md §11). O default atual do Supabase é ES256 assimétrico (ADR-018):
# verifica-se a assinatura contra a chave pública publicada no JWKS do projeto;
# o segredo HS256 legado é apenas fallback opcional.
# ----------------------------------------------------------------------------
# URL do projeto Supabase (Dashboard → Project Settings → API → Project URL).
# Também deriva o JWKS quando SUPABASE_JWKS_URL fica vazio.
SUPABASE_URL=
# JWKS do projeto (verificação ES256). Opcional: se vazio, derivado de
# SUPABASE_URL como <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=
# Segredo HS256 legado — fallback de verificação (Dashboard → API → JWT Secret).
# Opcional: projetos novos (ES256) não precisam dele.
SUPABASE_JWT_SECRET=

# ----------------------------------------------------------------------------
# Cloudflare R2 (storage S3-compatível das artes) — tudo ou nada:
# deixe as 4 vazias (storage 'down' no readiness) ou preencha as 4.
# ----------------------------------------------------------------------------
# Endpoint da conta: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Token de API R2 com permissão Object Read & Write no bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome do bucket de artes (ex.: rastreio-artes)
R2_BUCKET=

# ----------------------------------------------------------------------------
# HTTP
# ----------------------------------------------------------------------------
# Origens autorizadas no CORS, separadas por vírgula (URL do frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000
