# ============================================================================
# Frontend (apps/web) — variáveis de ambiente
# Copie para .env e preencha. Variáveis NEXT_PUBLIC_* seriam EMBUTIDAS no bundle
# do browser — por isso a auth usa vars SERVER-ONLY (sem NEXT_PUBLIC_).
# ============================================================================

# Backend FastAPI (server-only — NÃO NEXT_PUBLIC). Usado pelo rewrite /api/* do
# next.config.ts (browser → mesma origem → backend) e pelo fetch SSR.
# Dev local: http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Chave PÚBLICA ES256 (base64 do PEM) para verificar o cookie de sessão no Next
# (proxy/SSR). Server-only. É a MESMA chave pública do backend (AUTH_JWT_PUBLIC_KEY);
# não é segredo, mas fica fora de NEXT_PUBLIC_* (não precisa ir ao bundle).
AUTH_JWT_PUBLIC_KEY=
