# ============================================================================
# Backend (apps/api) — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env com valores reais.
# Provisionamento passo-a-passo: docs/setup-infra.md
# ============================================================================

# Ambiente de execução: dev | test | staging | production
# Em staging/produção DEFINA explicitamente — o default "dev" existe só para a
# DX local; se esquecido no deploy, a observabilidade (readiness/logs) rotularia
# o ambiente como "dev".
APP_ENV=dev

# Nível de log do backend (JSON estruturado em stdout): DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Banco de dados — DUAS URLs distintas (ADR-007)
# ----------------------------------------------------------------------------
# RUNTIME da aplicação → pooler de transação do Supabase (PORTA 6543, PgBouncer).
# Formato Supabase: postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:6543/postgres
#
# *** STAGING/PRODUÇÃO: USE O ROLE NÃO-OWNER `rastreio_runtime` (NOBYPASSRLS),
#     NUNCA o owner `postgres`. ***
#     A camada inferior do RBAC (RLS) só é defesa INDEPENDENTE se o role de
#     conexão não puder ignorá-la: um superuser/owner faz BYPASSRLS e passa por
#     cima das policies (o `FORCE ROW LEVEL SECURITY` NÃO anula isso — quem
#     fecha o cenário é conectar como role NOBYPASSRLS). O `rastreio_runtime`
#     nasce NOLOGIN (migration 0008/_runtime_role.sql); ativá-lo é passo de
#     operação — ver docs/rbac.md §"Role de runtime" e docs/provas.md §6:
#         ALTER ROLE rastreio_runtime LOGIN PASSWORD '<segredo-fora-do-repo>';
#     e no pooler do Supabase o usuário vira `rastreio_runtime.<project-ref>`.
#     A app RECUSA subir em staging/production se conectar com role
#     superuser/BYPASSRLS (checagem de boot — M-01). Tarefas de SISTEMA
#     (migrations, bootstrap_admin, keep-alive) seguem no owner via
#     MIGRATIONS_DATABASE_URL.
#
# Em dev local (docker compose up -d db), aponte para o Postgres local (o owner
# `postgres` é aceitável só fora de staging/production):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rastreio

# MIGRATIONS (Alembic) → conexão DIRETA/sessão (PORTA 5432) — DDL exige sessão.
# Formato Supabase (conexão direta): postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
#   ATENÇÃO: a conexão direta db.<ref>.supabase.co é IPv6-ONLY em projetos novos;
#   em rede sem IPv6 ela falha com gaierror. Alternativa portável (ADR-007,
#   emenda): POOLER EM MODO SESSION — mesma porta 5432, host do pooler, usuário
#   postgres.<ref> (suporta DDL/prepared statements):
#   postgresql://postgres.<ref>:<senha>@aws-1-<região>.pooler.supabase.com:5432/postgres
#   Detalhes em docs/setup-infra.md §1.
# Em dev local, pode ser a mesma instância do runtime:
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rastreio

# ----------------------------------------------------------------------------
# Autenticação PRÓPRIA — JWT ES256 emitido pela app (migração Supabase->local).
# Par de chaves EC P-256 em BASE64 do PEM (linha única — evita PEM multilinha).
# Gerar (a partir de apps/api):
#   uv run python -c "import base64,secrets; from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives import serialization as s; k=ec.generate_private_key(ec.SECP256R1()); print('AUTH_JWT_PRIVATE_KEY='+base64.b64encode(k.private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption())).decode()); print('AUTH_JWT_PUBLIC_KEY='+base64.b64encode(k.public_key().public_bytes(s.Encoding.PEM,s.PublicFormat.SubjectPublicKeyInfo)).decode())"
# Fora de dev/test a app RECUSA subir sem o par (fail-fast).
# ----------------------------------------------------------------------------
# Chave PRIVADA (assina o access token) — SERVER-ONLY, jamais no cliente.
AUTH_JWT_PRIVATE_KEY=
# Chave PÚBLICA (verifica o token) — backend e, na Fase 3, o proxy do Next.
AUTH_JWT_PUBLIC_KEY=
# Emissor (claim iss) dos tokens próprios. Default: rastreio-api.
AUTH_ISSUER=rastreio-api
# TTL do access token (segundos, curto) e do refresh token rotativo (mais longo).
AUTH_ACCESS_TTL_SECONDS=1800
AUTH_REFRESH_TTL_SECONDS=604800

# ----------------------------------------------------------------------------
# Cloudflare R2 (storage S3-compatível das artes) — tudo ou nada:
# deixe as 4 vazias (storage 'down' no readiness) ou preencha as 4.
# ----------------------------------------------------------------------------
# Endpoint da conta: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Token de API R2 com permissão Object Read & Write no bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome do bucket de artes (ex.: rastreio-artes)
R2_BUCKET=

# ----------------------------------------------------------------------------
# HTTP
# ----------------------------------------------------------------------------
# Origens autorizadas no CORS, separadas por vírgula (URL do frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000
