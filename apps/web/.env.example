# ============================================================================
# Frontend (apps/web) — variáveis de ambiente
# Copie para .env e preencha. Variáveis NEXT_PUBLIC_* são EMBUTIDAS no bundle
# do browser — nunca coloque segredos nelas (a anon key é pública por design;
# a proteção real dos dados é a RLS).
# Provisionamento passo-a-passo: docs/setup-infra.md
# ============================================================================

# URL do projeto Supabase (Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima/publishable do Supabase (Dashboard → Project Settings → API).
# É pública por design; o acesso a dados é controlado pela RLS (camada inferior
# do RBAC — CLAUDE.md §5.4).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL base da API FastAPI (dev local: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
